# Google Gemini — free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-your-key-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional: override only if Google changes the endpoint
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Embedding batching (chunks per API request; delay between batches)
EMBED_BATCH_SIZE=16
EMBED_REQUEST_DELAY=0.7

# Neon Postgres (recommended for production). Leave unset to use local SQLite + Chroma.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
# GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# Cookie Secure flag (set true on HTTPS / Render)
# COOKIE_SECURE=false

# Comma-separated browser origins allowed for credentialed CORS (local dual-port)
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000
